# CDC Pipeline Worker Configuration

# Service environment (production / development / test)
ENV=development

# Health check & metrics server port
HEALTH_PORT=8081

# Logging verbosity (debug, info, warn, error)
LOG_LEVEL=debug

# NATS JetStream connectivity url
NATS_URL=nats://localhost:4222

# Worker Group classification for task assignments
WORKER_GROUP=local

# Security & Encryption keys (must match API server to decrypt source/sink credentials)
ENCRYPTION_KEY=my-super-secret-key-32-chars-long!

# Sources, sinks, and pipelines are no longer preseeded from environment
# variables at startup -- a shipped default pipeline pointing at tables like
# users/orders/products doesn't match your real schema and crash-loops until
# someone deletes it. Configure sources, sinks, and pipelines through the
# dashboard/API instead, against tables that actually exist in your database.
