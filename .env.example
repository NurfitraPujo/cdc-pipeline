# Database configurations
POSTGRES_DB=production_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Debug Sink database
POSTGRES_DEBUG_DB=debug_db
POSTGRES_DEBUG_USER=postgres

# API Security and Encryption
#
# ENCRYPTION_KEY must be 16, 24, or 32 RAW bytes, or base64 that decodes to one
# of those lengths -- see crypto.GetEncryptionKey in internal/crypto/aes.go,
# which rejects anything else so that a weak passphrase can never be used as an
# AES key. The previous placeholder here read
# "my-super-secret-key-32-chars-long!", which is 34 bytes despite what it says,
# so copying this file verbatim produced a 500 on the first source or sink
# write. Prefer base64: it is unambiguous about the decoded length.
#
# Generate one with:  openssl rand -base64 32
ENCRYPTION_KEY=Y2hhbmdlLW1lLXRoaXMtaXMtYW4tZXhhbXBsZS1rZXk=
JWT_SECRET=my-super-secret-jwt-key!

# Comma-separated list of origins allowed to call the API from a browser.
# Unset falls back to the built-in list (localhost:3000 plus the deployed
# dashboards). Set this when serving the dashboard from any other origin.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Dashboard integration base URLs
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_INTERNAL_API_BASE_URL=http://api:8080/api/v1
