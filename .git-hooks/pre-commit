#!/usr/bin/env bash
set -eo pipefail

echo "========================================="
echo "   Running Pre-commit Harness Sensors    "
echo "========================================="

# 1. Run go vet (Go Static Correctness)
if [ -f "go.mod" ]; then
    echo "🔍 Running go vet..."
    go vet ./...
fi

# 2. Run golangci-lint (Backend Linter + Depguard Architecture Rules)
#
# --new-from-rev=HEAD lints only what this commit introduces. The repo carries
# ~517 pre-existing findings (errcheck/gocyclo/gosec/revive) that accumulated
# while this hook was broken by a v1/v2 config incompatibility; blocking on all
# of them would make every commit fail and train people to use --no-verify,
# which silently disables the tests and the docs sensor too.
# Tracked in docs/todos/golangci_lint_backlog.md -- remove the flag once clean.
if command -v golangci-lint &> /dev/null; then
    echo "🔍 Running golangci-lint (new issues only)..."
    golangci-lint run --new-from-rev=HEAD ./...
else
    echo "⚠️  golangci-lint not found. Skipping extended Go linting. Please install it for full architecture fencing."
fi

# 3. Run Biome lint & format check (Frontend Sensor)
#
# --staged scopes this to the files this commit actually touches. web/ carries
# pre-existing findings (noExplicitAny, formatting, import order) that predate
# this hook working; same reasoning as the Go linter above -- a sensor that
# always fails is a sensor everyone bypasses.
# NOTE: this also drops `tsc --noEmit`, which pnpm check used to run. A type
# error is a property of the whole program, not of one file, so it cannot be
# scoped to staged files -- and it currently fails on 25 pre-existing errors in
# a single test stub. The frontend therefore has NO typecheck gate right now.
# Tracked in docs/todos/web_biome_backlog.md -- fixing that one stub file is the
# unblocker; restore tsc here and add it to CI once it is clean.
if [ -d "web" ] && [ -f "web/package.json" ]; then
    echo "🔍 Running Biome check (staged files only)..."
    (cd web && npx biome check --staged --no-errors-on-unmatched)
fi

# 4. Run fast Go Unit Tests (Regression Sensor)
if [ -f "go.mod" ]; then
    echo "🧪 Running fast unit tests..."
    go test -short $(go list ./... | grep -v /test/e2e)
fi

# 5. Docs hygiene (documentation staleness sensor)
if [ -x "scripts/check-docs-hygiene.sh" ]; then
    scripts/check-docs-hygiene.sh
fi

echo "✅ All sensors passed! Commit allowed."
echo "========================================="
